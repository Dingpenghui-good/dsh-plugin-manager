{
    "dsh":  {
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-settings",
                                              "@deepseek-ai/dsh-client-ui-slots"
                                          ],
                               "platform":  "web"
                           },
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-client-ui-slots":  "^0.1.0-rc.0",
                             "react":  "^18.2.0",
                             "@deepseek-ai/dsh-client-locale":  "^0.1.0-rc.0",
                             "@deepseek-ai/dsh-client-runtime":  "^0.1.0-rc.0",
                             "@deepseek-ai/dsh-api-remotes":  "^0.1.0-rc.0",
                             "@deepseek-ai/dsh-typert-protocol":  "^0.1.0-rc.0",
                             "@deepseek-ai/dsh-host-plugin-inventory":  "^0.1.0-rc.0",
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/dsh-client-ui-primitives":  "^0.1.0-rc.0",
                             "@deepseek-ai/dsh-client-ui-settings":  "^0.1.0-rc.0"
                         },
    "description":  "Writable plugin management tab for DeepSeek Harness — toggle, enable/disable, and uninstall user-installed Cordis plugins from Settings",
    "type":  "module",
    "version":  "0.2.1",
    "files":  [
                  "lib",
                  "src",
                  "package.json",
                  "README.md",
                  "cordis.yml",
                  "cordis.patch.yml"
              ],
    "scripts":  {
                    "dev":  "tsdown --watch",
                    "build":  "tsdown"
                },
    "name":  "@dsh-plugin/plugin-manager",
    "main":  "./lib/index.js",
    "exports":  {
                    "./client":  {
                                     "types":  "./lib/client/client.d.ts",
                                     "default":  "./lib/client.js"
                                 },
                    "./package.json":  "./package.json",
                    ".":  {
                              "types":  "./lib/index.d.ts",
                              "default":  "./lib/index.js"
                          }
                },
    "devDependencies":  {
                            "tsdown":  "^0.22.14",
                            "typescript":  "^7.0.2",
                            "lightningcss":  "^1.33.0",
                            "@types/react-dom":  "^18.3.7",
                            "@types/react":  "^18.3.31",
                            "@types/node":  "^26.2.0"
                        },
    "license":  "MIT"
}